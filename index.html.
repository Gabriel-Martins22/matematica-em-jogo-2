<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Matemática em Jogo — Cavalieri & Ladrilhamento</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
:root{
  --bg-0:#05070f; --bg-1:#0a0e1e; --bg-2:#121830;
  --accent:#00e0ff; --accent-2:#ff2e88; --accent-3:#ffe14d;
  --good:#22e39a; --bad:#ff4d6d; --text:#e8eefc; --muted:#8a94b8;
  --font-display:'Orbitron',sans-serif; --font-body:'Inter',sans-serif;
}
html,body{height:100%;overflow:hidden;background:var(--bg-0);color:var(--text);font-family:var(--font-body);}
#game-container{position:relative;width:100vw;height:100vh;overflow:hidden;}
#bg-canvas{position:absolute;inset:0;z-index:0;}
#hud{position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 24px;background:linear-gradient(180deg,rgba(10,14,30,.9),rgba(10,14,30,.4));backdrop-filter:blur(10px);border-bottom:1px solid rgba(0,224,255,.15);}
#hud.hidden{display:none;}
.hud-left,.hud-right{display:flex;gap:24px;align-items:center;}
.hud-item{display:flex;flex-direction:column;gap:2px;}
.hud-label{font-family:var(--font-display);font-size:10px;letter-spacing:2px;color:var(--muted);}
.hud-value{font-family:var(--font-display);font-weight:700;font-size:18px;color:var(--accent);}
.hud-item.score .hud-value{color:var(--accent-3);}
.hud-item.clues .hud-value{color:var(--accent-2);}
.hud-center{flex:1;}
.progress-wrap{height:8px;background:rgba(255,255,255,.06);border-radius:99px;overflow:hidden;}
#progress-bar{height:100%;width:0%;background:linear-gradient(90deg,var(--accent),var(--accent-2));transition:width .5s ease;border-radius:99px;box-shadow:0 0 12px var(--accent);}
.screen{position:absolute;inset:0;display:none;align-items:center;justify-content:center;padding:24px;z-index:5;overflow-y:auto;}
.screen.active{display:flex;animation:fadeIn .5s ease;}
#screen-challenge.active,#screen-story.active,#screen-decision.active{padding-top:90px;align-items:flex-start;}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.title-hero{text-align:center;max-width:900px;padding:40px;}
.badge{display:inline-block;padding:6px 14px;border:1px solid var(--accent);color:var(--accent);font-family:var(--font-display);font-size:11px;letter-spacing:3px;border-radius:99px;margin-bottom:24px;box-shadow:0 0 20px rgba(0,224,255,.2);}
.game-title{font-family:var(--font-display);font-weight:900;font-size:clamp(28px,6vw,64px);line-height:1.1;letter-spacing:2px;margin-bottom:20px;}
.game-title .glitch{display:inline-block;color:var(--text);text-shadow:0 0 20px rgba(0,224,255,.6),0 0 40px rgba(255,46,136,.3);}
.game-title .amp{color:var(--accent-2);margin:0 12px;text-shadow:0 0 20px var(--accent-2);}
.subtitle{font-size:clamp(14px,2vw,18px);color:var(--muted);margin-bottom:30px;}
.title-meta{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;margin-bottom:36px;font-size:13px;color:var(--muted);}
.title-meta span{padding:6px 12px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:8px;}
.btn{font-family:var(--font-display);font-weight:700;letter-spacing:2px;font-size:13px;padding:14px 28px;border:none;border-radius:10px;cursor:pointer;transition:all .25s ease;text-transform:uppercase;}
.btn.primary{background:linear-gradient(135deg,var(--accent),#008cff);color:#001018;box-shadow:0 0 24px rgba(0,224,255,.4);}
.btn.primary:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 0 36px rgba(0,224,255,.7);}
.btn.primary:disabled{opacity:.35;cursor:not-allowed;box-shadow:none;}
.btn.big{padding:18px 40px;font-size:15px;margin:0 8px;}
.btn.ghost{background:transparent;border:1px solid rgba(255,255,255,.2);color:var(--text);margin:10px 8px;}
.btn.ghost:hover{border-color:var(--accent);color:var(--accent);}
.story-card{max-width:760px;width:100%;padding:40px;background:linear-gradient(160deg,rgba(18,24,48,.92),rgba(10,14,30,.95));border:1px solid rgba(0,224,255,.2);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.05);animation:fadeIn .5s ease;}
.story-chapter{font-family:var(--font-display);font-size:12px;letter-spacing:4px;color:var(--accent-2);margin-bottom:12px;}
.story-card h2{font-family:var(--font-display);font-size:clamp(22px,3vw,34px);margin-bottom:20px;line-height:1.2;color:var(--text);}
.story-card p{font-size:16px;line-height:1.75;color:#c5cee8;margin-bottom:16px;}
.story-extra{margin:20px 0 28px;padding:16px;background:rgba(0,224,255,.06);border-left:3px solid var(--accent);border-radius:8px;font-size:14px;color:var(--accent);font-style:italic;}
.challenge-card{max-width:820px;width:100%;padding:36px;background:linear-gradient(160deg,rgba(18,24,48,.95),rgba(10,14,30,.97));border:1px solid rgba(0,224,255,.2);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.6);animation:fadeIn .4s ease;}
.challenge-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;}
.ch-tags{display:flex;gap:8px;flex-wrap:wrap;}
.tag{padding:5px 12px;background:var(--accent);color:#001018;font-family:var(--font-display);font-size:10px;font-weight:700;letter-spacing:1px;border-radius:99px;}
.tag.outline{background:transparent;color:var(--accent);border:1px solid var(--accent);}
.ch-number{font-family:var(--font-display);color:var(--muted);font-size:12px;letter-spacing:2px;}
.challenge-card h3{font-size:clamp(16px,2.2vw,20px);line-height:1.6;font-weight:600;margin-bottom:24px;color:var(--text);}
.ch-body{margin-bottom:20px;}
.opt{display:block;width:100%;text-align:left;padding:16px 20px;margin-bottom:12px;background:rgba(255,255,255,.03);border:2px solid rgba(255,255,255,.08);border-radius:12px;color:var(--text);font-size:15px;cursor:pointer;transition:all .2s ease;font-family:var(--font-body);line-height:1.5;}
.opt:hover:not(.locked){border-color:var(--accent);background:rgba(0,224,255,.06);transform:translateX(4px);}
.opt.selected{border-color:var(--accent);background:rgba(0,224,255,.12);box-shadow:0 0 20px rgba(0,224,255,.2);}
.opt.correct{border-color:var(--good);background:rgba(34,227,154,.12);color:var(--good);}
.opt.wrong{border-color:var(--bad);background:rgba(255,77,109,.12);color:var(--bad);}
.opt.locked{cursor:not-allowed;}
.order-list{margin-bottom:16px;}
.order-item{padding:12px 16px;margin-bottom:8px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:10px;font-size:14px;display:flex;align-items:center;gap:12px;}
.order-num{font-family:var(--font-display);color:var(--accent);font-weight:700;min-width:24px;}
.feedback{margin:20px 0;padding:16px 20px;border-radius:12px;font-size:14px;line-height:1.6;animation:fadeIn .4s ease;}
.feedback.correct{background:rgba(34,227,154,.1);border-left:4px solid var(--good);color:#b8f5d8;}
.feedback.wrong{background:rgba(255,77,109,.1);border-left:4px solid var(--bad);color:#ffc2cf;}
.feedback b{color:var(--accent-3);}
.ch-actions{display:flex;justify-content:flex-end;gap:12px;margin-top:20px;}
.hidden{display:none !important;}
.decision-card{max-width:900px;width:100%;text-align:center;padding:40px;}
.decision-badge{display:inline-block;padding:8px 20px;background:var(--accent-2);color:#001018;font-family:var(--font-display);font-weight:700;font-size:12px;letter-spacing:3px;border-radius:99px;margin-bottom:24px;box-shadow:0 0 30px var(--accent-2);}
.decision-card h2{font-family:var(--font-display);font-size:clamp(22px,3vw,32px);margin-bottom:16px;}
.decision-card > p{font-size:16px;color:var(--muted);margin-bottom:32px;max-width:600px;margin-left:auto;margin-right:auto;line-height:1.6;}
.decision-options{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;}
.dec-opt{padding:28px;background:rgba(255,255,255,.03);border:2px solid rgba(255,255,255,.1);border-radius:16px;cursor:pointer;transition:all .3s ease;text-align:left;}
.dec-opt:hover{border-color:var(--accent);transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,224,255,.15);}
.dec-opt h3{font-family:var(--font-display);font-size:18px;color:var(--accent);margin-bottom:10px;}
.dec-opt p{font-size:14px;line-height:1.6;color:var(--muted);}
.dec-opt .dec-tag{display:inline-block;margin-top:12px;padding:4px 10px;background:rgba(255,225,77,.15);color:var(--accent-3);font-size:11px;font-family:var(--font-display);letter-spacing:1px;border-radius:6px;}
.end-card{max-width:760px;text-align:center;padding:50px 40px;background:linear-gradient(160deg,rgba(18,24,48,.95),rgba(10,14,30,.97));border-radius:24px;border:1px solid rgba(0,224,255,.25);box-shadow:0 30px 80px rgba(0,0,0,.7);animation:fadeIn .6s ease;}
.end-badge{display:inline-block;padding:8px 20px;font-family:var(--font-display);font-weight:700;font-size:12px;letter-spacing:3px;border-radius:99px;margin-bottom:24px;}
.end-badge.good{background:linear-gradient(135deg,var(--good),#00b8c4);color:#001018;box-shadow:0 0 30px var(--good);}
.end-badge.bad{background:linear-gradient(135deg,var(--bad),#ff7a4d);color:#001018;box-shadow:0 0 30px var(--bad);}
.end-card h1{font-family:var(--font-display);font-size:clamp(24px,4vw,40px);margin-bottom:20px;line-height:1.2;}
.end-card p{font-size:16px;line-height:1.7;color:#c5cee8;margin-bottom:24px;}
.end-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:16px;margin:32px 0;}
.stat{padding:20px;background:rgba(255,255,255,.03);border-radius:12px;border:1px solid rgba(255,255,255,.08);}
.stat-label{font-family:var(--font-display);font-size:10px;letter-spacing:2px;color:var(--muted);margin-bottom:8px;}
.stat-value{font-family:var(--font-display);font-size:24px;font-weight:700;color:var(--accent);}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(6px);z-index:100;display:flex;align-items:center;justify-content:center;padding:24px;}
.modal-content{max-width:560px;width:100%;background:var(--bg-1);border:1px solid var(--accent);border-radius:20px;padding:32px;box-shadow:0 0 60px rgba(0,224,255,.3);}
.modal-content h2{font-family:var(--font-display);color:var(--accent);margin-bottom:20px;font-size:22px;}
.modal-content ul{padding-left:20px;margin-bottom:24px;}
.modal-content li{margin-bottom:12px;line-height:1.6;font-size:14px;color:#c5cee8;}
.modal-content b{color:var(--accent-3);}
@media(max-width:720px){.hud-left,.hud-right{gap:14px;}.hud-label{font-size:9px;letter-spacing:1px;}.hud-value{font-size:15px;}.challenge-card,.story-card{padding:24px;}.title-meta{gap:10px;font-size:11px;}.btn.big{padding:14px 24px;font-size:13px;}#hud{padding:12px 14px;}.hud-center{display:none;}}
</style>
</head>
<body>
<div id="game-container">
  <canvas id="bg-canvas"></canvas>

  <header id="hud" class="hidden">
    <div class="hud-left">
      <div class="hud-item"><span class="hud-label">CAPÍTULO</span><span id="hud-chapter" class="hud-value">1</span></div>
      <div class="hud-item"><span class="hud-label">DESAFIO</span><span id="hud-challenge" class="hud-value">1/15</span></div>
    </div>
    <div class="hud-center"><div class="progress-wrap"><div id="progress-bar"></div></div></div>
    <div class="hud-right">
      <div class="hud-item score"><span class="hud-label">PONTOS</span><span id="hud-score" class="hud-value">0</span></div>
      <div class="hud-item clues"><span class="hud-label">PISTAS</span><span id="hud-clues" class="hud-value">0/3</span></div>
    </div>
  </header>

  <section id="screen-title" class="screen active">
    <div class="title-hero">
      <div class="badge">PROJETO MATEMÁTICA EM JOGO</div>
      <h1 class="game-title"><span class="glitch">CAVALIERI</span><span class="amp">&</span><span class="glitch">LADRILHAMENTO</span></h1>
      <p class="subtitle">A Reforma da Escola — Uma aventura geométrica em 3 capítulos</p>
      <div class="title-meta">
        <span>👤 Alex — Monitor Júnior de Arquitetura</span>
        <span>📐 15 desafios</span>
        <span>🎯 2 finais</span>
      </div>
      <button id="btn-start" class="btn primary big">▶ INICIAR JORNADA</button>
      <button id="btn-howto" class="btn ghost">Como Jogar</button>
    </div>
  </section>

  <section id="screen-story" class="screen">
    <div class="story-card">
      <div class="story-chapter" id="story-chapter-tag">CAPÍTULO 1</div>
      <h2 id="story-title"></h2>
      <p id="story-text"></p>
      <div id="story-extra" class="story-extra"></div>
      <button id="btn-story-continue" class="btn primary">CONTINUAR →</button>
    </div>
  </section>

  <section id="screen-challenge" class="screen">
    <div class="challenge-card">
      <div class="challenge-header">
        <div class="ch-tags">
          <span class="tag" id="ch-format">FORMATO</span>
          <span class="tag outline" id="ch-chapter">CAPÍTULO 1</span>
        </div>
        <div class="ch-number" id="ch-number">DESAFIO 01</div>
      </div>
      <h3 id="ch-question"></h3>
      <div id="ch-body" class="ch-body"></div>
      <div id="ch-feedback" class="feedback hidden"></div>
      <div class="ch-actions">
        <button id="btn-answer" class="btn primary" disabled>CONFIRMAR RESPOSTA</button>
        <button id="btn-next" class="btn primary hidden">PRÓXIMO →</button>
      </div>
    </div>
  </section>

  <section id="screen-decision" class="screen">
    <div class="decision-card">
      <div class="decision-badge">PONTO DE DECISÃO</div>
      <h2 id="dec-title"></h2>
      <p id="dec-text"></p>
      <div class="decision-options" id="dec-options"></div>
    </div>
  </section>

  <section id="screen-end" class="screen">
    <div class="end-card">
      <div class="end-badge" id="end-badge">FINAL</div>
      <h1 id="end-title"></h1>
      <p id="end-text"></p>
      <div class="end-stats" id="end-stats"></div>
      <div class="end-buttons">
        <button id="btn-replay" class="btn primary">JOGAR NOVAMENTE</button>
      </div>
    </div>
  </section>

  <div id="modal-howto" class="modal hidden">
    <div class="modal-content">
      <h2>Como Jogar</h2>
      <ul>
        <li>Você é <b>Alex</b>, Monitor Júnior de Arquitetura, encarregado de reformar o pátio e a Sala de Memória da escola.</li>
        <li>Cada desafio testa um conceito de <b>Ladrilhamento</b> (Cap. 1) ou <b>Princípio de Cavalieri</b> (Cap. 2-3).</li>
        <li>Acertos valem pontos e libertam <b>pistas</b>. Erros custam pontos, mas você sempre pode aprender com o feedback.</li>
        <li>Existem <b>2 decisões</b> que mudam o rumo da história.</li>
        <li>No fim, o <b>desempenho (≥ 80%)</b> e suas escolhas definem o final: <i>Obra Sustentável</i> ou <i>Retrabalho Estrutural</i>.</li>
      </ul>
      <button id="btn-close-howto" class="btn primary">ENTENDI</button>
    </div>
  </div>
</div>

<script>
/* ================= CANVAS DE FUNDO ================= */
const bgCanvas=document.getElementById('bg-canvas'),bgCtx=bgCanvas.getContext('2d');
let W,H;
function resize(){W=bgCanvas.width=window.innerWidth;H=bgCanvas.height=window.innerHeight;}
resize();window.addEventListener('resize',resize);
const shapes=[];const shapeTypes=['hex','tri','sq','oct'];
function makeShape(){return{type:shapeTypes[Math.floor(Math.random()*shapeTypes.length)],x:Math.random()*W,y:Math.random()*H,size:15+Math.random()*25,rot:Math.random()*Math.PI*2,rotSpeed:(Math.random()-.5)*.008,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25,alpha:.05+Math.random()*.12,hue:Math.random()>.5?190:330};}
for(let i=0;i<40;i++)shapes.push(makeShape());
function drawPolygon(ctx,x,y,sides,size,rot){ctx.beginPath();for(let i=0;i<sides;i++){const a=rot+(i*Math.PI*2)/sides;const px=x+Math.cos(a)*size;const py=y+Math.sin(a)*size;i===0?ctx.moveTo(px,py):ctx.lineTo(px,py);}ctx.closePath();}
function animateBG(){
  bgCtx.clearRect(0,0,W,H);
  const g=bgCtx.createRadialGradient(W/2,H/2,0,W/2,H/2,Math.max(W,H)/1.2);
  g.addColorStop(0,'rgba(20,28,58,.9)');g.addColorStop(.5,'rgba(10,14,30,1)');g.addColorStop(1,'rgba(5,7,15,1)');
  bgCtx.fillStyle=g;bgCtx.fillRect(0,0,W,H);
  bgCtx.strokeStyle='rgba(0,224,255,.03)';bgCtx.lineWidth=1;const grid=50;
  for(let x=0;x<W;x+=grid){bgCtx.beginPath();bgCtx.moveTo(x,0);bgCtx.lineTo(x,H);bgCtx.stroke();}
  for(let y=0;y<H;y+=grid){bgCtx.beginPath();bgCtx.moveTo(0,y);bgCtx.lineTo(W,y);bgCtx.stroke();}
  shapes.forEach(s=>{
    s.x+=s.vx;s.y+=s.vy;s.rot+=s.rotSpeed;
    if(s.x<-50)s.x=W+50;if(s.x>W+50)s.x=-50;if(s.y<-50)s.y=H+50;if(s.y>H+50)s.y=-50;
    const sides=s.type==='hex'?6:s.type==='tri'?3:s.type==='sq'?4:8;
    bgCtx.save();
    bgCtx.strokeStyle=`hsla(${s.hue},100%,60%,${s.alpha+.15})`;
    bgCtx.fillStyle=`hsla(${s.hue},100%,60%,${s.alpha*.3})`;
    bgCtx.lineWidth=1.2;
    drawPolygon(bgCtx,s.x,s.y,sides,s.size,s.rot);bgCtx.fill();bgCtx.stroke();
    bgCtx.restore();
  });
  requestAnimationFrame(animateBG);
}
animateBG();

/* ================= ESTADO ================= */
const state={score:0,correctCount:0,challengeIndex:0,clues:0,chapter:1,decisions:{patio:null,method:null}};

/* ================= HISTÓRIA ================= */
const STORY={
  'story-1-1':{tag:'CAPÍTULO 1',title:'O Dilema do Pátio',text:'Você é Alex, estudante do ensino técnico em Edificações e recém-nomeado Monitor Júnior de Arquitetura da Escola. A diretora te chama: o pátio central sofreu rachaduras graves por mau assentamento das lajotas. Antes de comprar material, é preciso descobrir qual padrão geométrico fecha o piso sem brechas.',extra:'🔑 Pista recebida: Gabarito Geométrico de Vértices (mede somas de ângulos internos em cada vértice).'},
  'story-2-1':{tag:'CAPÍTULO 2',title:'A Sala Torta de Memória',text:'O pátio está resolvido! Agora Alex precisa calcular o volume real da Sala de Memória Histórica, cujas paredes são oblíquas e o teto é inclinado. Novos armários planejados devem caber sem sobras nem faltas. O Mestre de Obras entrega o Esquadro Integrador de Cavalieri e o Relatório de Sobras.',extra:'🔑 Novas pistas: Esquadro Integrador de Cavalieri + Relatório de Sobras.'},
  'story-3-1':{tag:'CAPÍTULO 3',title:'O Teste Final da Reforma',text:'A reforma está quase pronta! Mas o Conselho Escolar exige uma auditoria final. Alex precisa consolidar os dados, justificar matematicamente cada decisão perante os conselheiros e apresentar o protótipo final da obra. As pistas coletadas serão decisivas.',extra:'⚡ Você tem 3 desafios finais para provar o domínio dos conceitos.'}
};

/* ================= DESAFIOS ================= */
const CHALLENGES=[
  {id:1,chapter:1,format:'Escolher resposta',question:'Alex encaixou dois triângulos equiláteros (60° cada) e um quadrado (90°) num vértice. Qual polígono regular fecha exatamente os 360°?',options:[{text:'Pentágono regular (108°)',correct:false},{text:'Hexágono regular (120°)',correct:false},{text:'Dodecágono regular (150°)',correct:true},{text:'Octógono regular (135°)',correct:false}],feedback:{correct:'✔ 60° + 60° + 90° = 210°. Para 360° faltam exatamente 150°, que corresponde ao ângulo interno do polígono de 12 lados (dodecágono).',wrong:'✘ Some os ângulos já presentes: 60° + 60° + 90° = 210°. Faltam 150°, que é o ângulo interno do dodecágono (n = 12).'}},
  {id:2,chapter:1,format:'Medir / estimar',question:'O pátio possui 100 m². Alex quer usar peças quadradas de 0,5 m × 0,5 m. Estimando uma perda de 5% em cortes nas bordas, quantas peças devem ser encomendadas?',options:[{text:'400 peças',correct:false},{text:'420 peças',correct:true},{text:'450 peças',correct:false},{text:'500 peças',correct:false}],feedback:{correct:'✔ Área de cada peça = 0,25 m². Sem perdas: 100/0,25 = 400 peças. Com 5% de margem: 400 × 1,05 = 420 peças.',wrong:'✘ Cada peça tem 0,5 × 0,5 = 0,25 m². São necessárias 100 ÷ 0,25 = 400 peças. Com 5% de perda: 400 × 1,05 = 420.'}},
  {id:3,chapter:1,format:'Interpretar figura',question:'Analisando a planta do pátio, Alex nota que um trecho usa apenas triângulos equiláteros. Quantos triângulos equiláteros se encontram em um único vértice para formar um ladrilhamento regular completo?',options:[{text:'4',correct:false},{text:'5',correct:false},{text:'6',correct:true},{text:'8',correct:false}],feedback:{correct:'✔ Cada ângulo interno do triângulo equilátero mede 60°. Para totalizar 360°: 360/60 = 6 triângulos.',wrong:'✘ O ângulo interno do triângulo equilátero é 60°. Divida 360° por 60°: são necessários 6 triângulos.'}},
  {id:4,chapter:1,format:'Organizar algoritmo',question:'Ordene a sequência correta para verificar se uma combinação de polígonos pode ladrilhar o plano:',orderItems:['Identificar o número de lados (n) de cada polígono.','Calcular o ângulo interno de cada polígono: Aᵢ = (n − 2) × 180 / n.','Somar os ângulos de todas as figuras que se encontram no vértice.','Verificar se a soma resulta em exatamente 360°.'],options:[{text:'1 → 2 → 3 → 4',correct:true},{text:'2 → 1 → 3 → 4',correct:false},{text:'4 → 3 → 2 → 1',correct:false},{text:'1 → 3 → 2 → 4',correct:false}],feedback:{correct:'✔ Primeiro identifica-se o número de lados, depois calcula-se o ângulo interno, soma-se no vértice e, por fim, compara-se com 360°.',wrong:'✘ A ordem lógica é: descobrir n → calcular ângulo interno → somar no vértice → conferir se dá 360°.'}},
  {id:5,chapter:1,format:'Associar modelo e fenômeno',question:'Qual das situações abaixo representa um IMPEDIMENTO matemático para o ladrilhamento regular do chão?',options:[{text:'O ângulo interno do polígono ser um divisor exato de 360°.',correct:false},{text:'O polígono ser um pentágono regular (A = 108°).',correct:true},{text:'A soma dos ângulos no vértice ser igual a 360°.',correct:false},{text:'O uso simultâneo de quadrados e octógonos em padrão constante.',correct:false}],feedback:{correct:'✔ 360° / 108° ≈ 3,33 (não inteiro). Três pentágonos deixam uma lacuna de 36°; quatro se sobrepõem.',wrong:'✘ O pentágono regular tem ângulo interno de 108°. Como 360/108 não é inteiro, ele não ladrilha o plano sozinho.'}},
  {id:6,chapter:2,format:'Escolher resposta',question:'A Sala de Memória é um prisma inclinado de altura h = 4 m e base retangular de 5 m × 3 m. Um depósito reto vizinho tem a mesma altura e base idêntica. Qual é o volume da Sala de Memória?',options:[{text:'30 m³',correct:false},{text:'60 m³',correct:true},{text:'45 m³',correct:false},{text:'Impossível calcular sem o ângulo de inclinação.',correct:false}],feedback:{correct:'✔ Pelo Princípio de Cavalieri: V = Área da Base × Altura = (5 × 3) × 4 = 60 m³, independente da inclinação.',wrong:'✘ Aplicando Cavalieri: V = A_base × h = (5 × 3) × 4 = 60 m³. A inclinação não altera o volume.'}},
  {id:7,chapter:2,format:'Encontrar e corrigir erro',question:'Um estagiário afirmou: "Se dois sólidos têm o mesmo volume e a mesma altura, suas secções transversais são obrigatoriamente iguais em todas as alturas." Qual o erro dessa afirmação?',options:[{text:'Não há erro, esta é a definição exata do Princípio de Cavalieri.',correct:false},{text:'O erro é assumir a recíproca: volumes iguais não garantem secções idênticas em cada altura.',correct:true},{text:'O erro é dizer que a altura precisa ser igual.',correct:false},{text:'O erro é aplicar a regra para sólidos tridimensionais.',correct:false}],feedback:{correct:'✔ A propriedade de Cavalieri é direta (secções iguais → volumes iguais). Dois sólidos podem ter o mesmo volume com distribuições de massa totalmente diferentes ao longo da altura.',wrong:'✘ Cuidado com a recíproca: volumes iguais NÃO garantem secções idênticas. A implicação válida é: secções iguais → volumes iguais.'}},
  {id:8,chapter:2,format:'Medir / estimar',question:'Um reservatório de água em forma de cilindro inclinado possui raio de base r = 1 m e altura vertical h = 2 m. Qual a capacidade aproximada de água em litros? (Use π ≈ 3,14)',options:[{text:'3.140 litros',correct:false},{text:'6.280 litros',correct:true},{text:'12.560 litros',correct:false},{text:'2.000 litros',correct:false}],feedback:{correct:'✔ A = π·r² = 3,14 m². V = A·h = 3,14 × 2 = 6,28 m³ = 6.280 L.',wrong:'✘ Área da base: π·r² = 3,14 × 1² = 3,14 m². Volume: 3,14 × 2 = 6,28 m³. Como 1 m³ = 1000 L: 6.280 litros.'}},
  {id:9,chapter:2,format:'Interpretar tabela',question:'Um scanner 3D gerou a tabela de áreas das secções transversais de uma coluna decorativa a cada metro de altura (0 a 3 m): A(0) = 2 m², A(1) = 2 m², A(2) = 2 m², A(3) = 2 m². Alex pode comparar essa coluna a qual sólido reto tradicional?',options:[{text:'A um cone reto.',correct:false},{text:'A uma pirâmide quadrada.',correct:false},{text:'A um prisma ou cilindro reto de base 2 m².',correct:true},{text:'A uma esfera de raio 2 m.',correct:false}],feedback:{correct:'✔ A área da secção é constante (2 m²) em toda a extensão vertical. O sólido é equivalente a um prisma/cilindro reto de mesma base e altura.',wrong:'✘ Como a área das secções NÃO varia com a altura, o sólido é equivalente a um prisma ou cilindro reto de base 2 m².'}},
  {id:10,chapter:2,format:'Selecionar dados relevantes',question:'Para calcular o volume de um galpão com teto inclinado usando Cavalieri, o Mestre de Obras forneceu: (1) comprimento da geratriz inclinada = 10 m; (2) altura vertical = 6 m; (3) área da base horizontal = 50 m²; (4) peso da estrutura = 12 t. Quais dados são estritamente necessários?',options:[{text:'Todos os 4 dados.',correct:false},{text:'Apenas (1) e (3).',correct:false},{text:'Apenas (2) e (3).',correct:true},{text:'Apenas (1), (2) e (3).',correct:false}],feedback:{correct:'✔ Por Cavalieri, V = A_base × h (altura perpendicular). Comprimento inclinado e peso são irrelevantes para o volume geométrico.',wrong:'✘ Só precisamos da área da base (3) e da altura vertical (2). Geratriz inclinada e peso não entram no volume.'}},
  {id:11,chapter:2,format:'Associar modelo e fenômeno',question:'Ao cortar uma laranja (aproximadamente esférica) em fatias paralelas finas, a área do círculo exposto varia com a altura da fatia. Para deduzir o volume da esfera por Cavalieri, ela é tradicionalmente comparada a qual sólido composto?',options:[{text:'A um cubo perfeito.',correct:false},{text:'A um cilindro subtraído de dois cones (ampulheta contida no cilindro).',correct:true},{text:'A uma pirâmide reta de base hexagonal.',correct:false},{text:'A dois paralelepípedos sobrepostos.',correct:false}],feedback:{correct:'✔ O modelo clássico de Cavalieri demonstra que a secção transversal de uma meia-esfera equivale à secção entre um cilindro e um cone invertido à mesma altura.',wrong:'✘ A demonstração clássica compara a meia-esfera ao cilindro MENOS dois cones (a ampulheta inscrita).'}},
  {id:12,chapter:3,format:'Construir previsão',question:'Alex prevê que, ao dobrar a altura de qualquer sólido oblíquo mantendo as secções transversais iguais, o volume dobrará. Essa previsão possui limite de aplicação?',options:[{text:'Não, vale para qualquer figura tridimensional sem exceção.',correct:false},{text:'Sim, só funciona se a inclinação for menor que 45°.',correct:false},{text:'Não tem limites geométricos, desde que o formato da secção em cada altura proporcional seja mantido escalonado.',correct:true},{text:'Funciona apenas para sólidos retos.',correct:false}],feedback:{correct:'✔ A relação V ∝ h é linear pelo Princípio de Cavalieri, contanto que a área das secções não seja alterada no processo.',wrong:'✘ Pelo Princípio de Cavalieri, o volume é proporcional à altura (V ∝ h) desde que as áreas das secções transversais não mudem.'}},
  {id:13,chapter:3,format:'Decisão com consequências',question:'O Conselho Escolar exige cortar 15% dos custos da reforma. Qual decisão matemática Alex deve tomar para reduzir custos sem comprometer a estrutura?',options:[{text:'Substituir o ladrilhamento regular de hexágonos por uma mistura aleatória de polígonos sem verificar os vértices.',correct:false},{text:'Reduzir a altura do teto da Sala de Memória mantendo a área da base, aplicando Cavalieri para recalcular o novo volume útil.',correct:true},{text:'Deixar frestas de 2 cm entre as lajotas para economizar peças.',correct:false},{text:'Calcular o volume usando a geratriz inclinada em vez da altura vertical.',correct:false}],feedback:{correct:'✔ A alteração controlada da altura reduz o volume de material de forma previsível e matematicamente válida. As outras opções geram falhas de engenharia.',wrong:'✘ A única opção tecnicamente válida é reduzir a altura mantendo a base — o que diminui o volume de forma linear e segura.'}},
  {id:14,chapter:3,format:'Decisão com evidências',question:'Duas marcas vendem peças para o pátio: Marca X (pentágonos regulares) e Marca Y (octógonos + quadrados). Qual deve ser a escolha sustentada por evidências matemáticas?',options:[{text:'Marca X, pois o pentágono é uma figura mais bonita.',correct:false},{text:'Marca X, pois gasta menos peças por metro quadrado.',correct:false},{text:'Marca Y, pois a combinação 8.8.4 fecha 360° no vértice, enquanto o pentágono isolado deixa frestas.',correct:true},{text:'Qualquer uma das marcas, pois todas as figuras regulares cobrem o plano.',correct:false}],feedback:{correct:'✔ O pentágono regular isolado NÃO tessela o plano (108° não divide 360°), tornando a Marca X inviável sem cortes irregulares.',wrong:'✘ O pentágono não ladrilha o plano sozinho (108° × 3 = 324°, sobram 36°). A combinação 8.8.4 dos octógonos + quadrados fecha 360°.'}},
  {id:15,chapter:3,format:'Encontrar e corrigir erro',question:'Um fornecedor tenta vender lajotas afirmando: "Como este triângulo possui lados de 3 cm, 4 cm e 5 cm, você pode juntar 5 deles no mesmo vértice para formar um ladrilhamento regular." Qual o erro do fornecedor?',options:[{text:'Triângulos não cobrem o plano em nenhuma hipótese.',correct:false},{text:'O triângulo 3-4-5 não é regular (ângulos de 90°, ≈ 53°, ≈ 37°), logo não forma ladrilhamento regular.',correct:true},{text:'Cinco triângulos somam 500° no vértice.',correct:false},{text:'O erro é que 3, 4 e 5 não são números primos.',correct:false}],feedback:{correct:'✔ Ladrilhamento regular exige polígonos regulares (lados e ângulos congruentes). Triângulos escalenos podem tesselar, mas jamais formar um ladrilhamento REGULAR.',wrong:'✘ O triângulo 3-4-5 é escaleno (ângulos diferentes). Ladrilhamento regular exige polígonos regulares (todos os lados e ângulos iguais).'}}
];

/* ================= DECISÕES ================= */
const DECISIONS={
  1:{title:'Escolha do Padrão do Pátio',text:'Alex precisa decidir qual padrão de lajotas usar no pátio. Cada escolha muda o tipo de cálculo e as pistas obtidas.',options:[
    {id:'hex',title:'Rota A — Hexágonos',desc:'Padrão regular econômico. Cada hexágono tem 120° e três fecham um vértice. Menor custo e mais simples.',tag:'REGULAR'},
    {id:'oct',title:'Rota B — Octógonos + Quadrados',desc:'Padrão semirregular 8.8.4 (135° + 135° + 90° = 360°). Mais estético e valoriza o espaço.',tag:'SEMIRREGULAR'}
  ]},
  2:{title:'Método de Medição da Sala',text:'A Sala de Memória tem paredes oblíquas. Alex pode escolher como calcular seu volume.',options:[
    {id:'cavalieri',title:'Rota X — Princípio de Cavalieri',desc:'Análise rápida via secções transversais equivalentes. Ganha o Esquadro Integrador e reduz a tolerância de erro no final.',tag:'RÁPIDO'},
    {id:'decomposicao',title:'Rota Y — Decomposição Rígida',desc:'Método demorado, dividindo o sólido em partes retas. Caminho completo, sem bônus.',tag:'TRADICIONAL'}
  ]}
};

/* ================= DOM ================= */
const $=id=>document.getElementById(id);
const screens={title:$('screen-title'),story:$('screen-story'),challenge:$('screen-challenge'),decision:$('screen-decision'),end:$('screen-end')};
const hud=$('hud');
function showScreen(name){Object.values(screens).forEach(s=>s.classList.remove('active'));screens[name].classList.add('active');}
function updateHUD(){$('hud-chapter').textContent=state.chapter;$('hud-challenge').textContent=`${state.challengeIndex}/15`;$('hud-score').textContent=state.score;$('hud-clues').textContent=`${state.clues}/3`;$('progress-bar').style.width=(state.challengeIndex/15)*100+'%';}

/* ================= FLUXO ================= */
let currentChallenge=null;let selectedAnswer=null;

function startGame(){
  state.score=0;state.correctCount=0;state.challengeIndex=0;state.clues=0;state.chapter=1;state.decisions={patio:null,method:null};
  hud.classList.remove('hidden');
  showStory('story-1-1');
}

function showStory(key){
  const s=STORY[key];if(!s){return;}
  $('story-chapter-tag').textContent=s.tag;
  $('story-title').textContent=s.title;
  $('story-text').textContent=s.text;
  $('story-extra').textContent=s.extra;
  showScreen('story');
  $('btn-story-continue').onclick=()=>{
    if(key==='story-1-1'){state.chapter=1;showChallenge(0);}
    else if(key==='story-2-1'){state.chapter=2;showChallenge(5);}
    else if(key==='story-3-1'){state.chapter=3;showChallenge(11);}
  };
}

function showChallenge(index){
  if(index>=CHALLENGES.length){showEnd();return;}
  currentChallenge=CHALLENGES[index];
  selectedAnswer=null;
  state.challengeIndex=index+1;
  updateHUD();
  $('ch-format').textContent=currentChallenge.format.toUpperCase();
  $('ch-chapter').textContent=`CAPÍTULO ${currentChallenge.chapter}`;
  $('ch-number').textContent=`DESAFIO ${String(currentChallenge.id).padStart(2,'0')}`;
  $('ch-question').textContent=currentChallenge.question;
  const body=$('ch-body');body.innerHTML='';
  if(currentChallenge.orderItems){
    const wrap=document.createElement('div');wrap.className='order-list';
    currentChallenge.orderItems.forEach((item,i)=>{
      const el=document.createElement('div');el.className='order-item';
      el.innerHTML=`<span class="order-num">${i+1}</span><span>${item}</span>`;
      wrap.appendChild(el);
    });
    body.appendChild(wrap);
  }
  currentChallenge.options.forEach((opt,i)=>{
    const btn=document.createElement('button');
    btn.className='opt';
    btn.innerHTML=`<b>${String.fromCharCode(65+i)})</b> ${opt.text}`;
    btn.onclick=()=>{
      if(btn.classList.contains('locked'))return;
      document.querySelectorAll('.opt').forEach(o=>o.classList.remove('selected'));
      btn.classList.add('selected');
      selectedAnswer=i;
      $('btn-answer').disabled=false;
    };
    body.appendChild(btn);
  });
  const fb=$('ch-feedback');fb.className='feedback hidden';fb.innerHTML='';
  $('btn-answer').classList.remove('hidden');$('btn-answer').disabled=true;
  $('btn-answer').onclick=()=>submitAnswer(index);
  $('btn-next').classList.add('hidden');
  showScreen('challenge');
}

function submitAnswer(index){
  if(selectedAnswer===null)return;
  const ch=currentChallenge;const opt=ch.options[selectedAnswer];const fb=$('ch-feedback');
  document.querySelectorAll('.opt').forEach((o,i)=>{
    o.classList.add('locked');
    if(ch.options[i].correct)o.classList.add('correct');
    else if(i===selectedAnswer&&!opt.correct)o.classList.add('wrong');
  });
  if(opt.correct){
    state.score+=100;state.correctCount++;
    if(index===0||index===5||index===11)state.clues=Math.min(3,state.clues+1);
    fb.className='feedback correct';fb.innerHTML=`<b>${ch.feedback.correct}</b>`;
  }else{
    fb.className='feedback wrong';fb.innerHTML=`<b>${ch.feedback.wrong}</b>`;
  }
  fb.classList.remove('hidden');updateHUD();
  $('btn-answer').classList.add('hidden');
  $('btn-next').classList.remove('hidden');
  $('btn-next').textContent=(index+1===CHALLENGES.length)?'FINALIZAR →':'PRÓXIMO →';
  $('btn-next').onclick=()=>advance(index);
}

function advance(index){
  if(index===4&&!state.decisions.patio){showDecision(1);return;}
  if(index===10&&!state.decisions.method){showDecision(2);return;}
  if(index===4&&state.decisions.patio){showStory('story-2-1');return;}
  if(index===10&&state.decisions.method){showStory('story-3-1');return;}
  showChallenge(index+1);
}

function showDecision(id){
  const d=DECISIONS[id];
  $('dec-title').textContent=d.title;
  $('dec-text').textContent=d.text;
  const wrap=$('dec-options');wrap.innerHTML='';
  d.options.forEach(opt=>{
    const card=document.createElement('div');card.className='dec-opt';
    card.innerHTML=`<h3>${opt.title}</h3><p>${opt.desc}</p><span class="dec-tag">${opt.tag}</span>`;
    card.onclick=()=>chooseDecision(id,opt.id);
    wrap.appendChild(card);
  });
  showScreen('decision');
}

function chooseDecision(id,choice){
  if(id===1){state.decisions.patio=choice;showStory('story-2-1');}
  else{state.decisions.method=choice;showStory('story-3-1');}
}

/* ================= FINAL ================= */
function showEnd(){
  const pct=Math.round((state.correctCount/15)*100);
  const isGood=pct>=80;
  const badge=$('end-badge');const title=$('end-title');const text=$('end-text');
  if(isGood){
    badge.className='end-badge good';badge.textContent='FINAL A';
    title.textContent='🏆 Obra Sustentável';
    text.textContent=`Alex apresenta o projeto ao Conselho Escolar. Com ${state.correctCount}/15 acertos (${pct}%), a escola economiza 25% da verba. O pátio fica perfeito, a Sala de Memória ganha armários sob medida e o nome de Alex é celebrado como o Monitor Júnior que dominou Cavalieri e Ladrilhamento!`;
  }else{
    badge.className='end-badge bad';badge.textContent='FINAL B';
    title.textContent='⚠️ Retrabalho Estrutural';
    text.textContent=`Com ${state.correctCount}/15 acertos (${pct}%), o piso do pátio apresenta brechas por erro de soma angular, e os armários não cabem na Sala de Memória. Alex precisa refazer parte da obra. Mas toda experiência ensina: na próxima, os conceitos de Cavalieri e Ladrilhamento estarão dominados!`;
  }
  const decPatio=state.decisions.patio==='hex'?'Hexágonos (regular)':'Octógonos + Quadrados (semirregular)';
  const decMethod=state.decisions.method==='cavalieri'?'Cavalieri (rápido)':'Decomposição Rígida';
  $('end-stats').innerHTML=`
    <div class="stat"><div class="stat-label">ACERTOS</div><div class="stat-value">${state.correctCount}/15</div></div>
    <div class="stat"><div class="stat-label">APROVEITAMENTO</div><div class="stat-value">${pct}%</div></div>
    <div class="stat"><div class="stat-label">PONTOS</div><div class="stat-value">${state.score}</div></div>
    <div class="stat"><div class="stat-label">PADRÃO DO PÁTIO</div><div class="stat-value" style="font-size:14px">${decPatio}</div></div>
    <div class="stat"><div class="stat-label">MÉTODO SALA</div><div class="stat-value" style="font-size:14px">${decMethod}</div></div>
  `;
  showScreen('end');
}

/* ================= EVENTOS GLOBAIS ================= */
$('btn-start').onclick=startGame;
$('btn-replay').onclick=()=>{showScreen('title');hud.classList.add('hidden');};
$('btn-howto').onclick=()=>$('modal-howto').classList.remove('hidden');
$('btn-close-howto').onclick=()=>$('modal-howto').classList.add('hidden');
</script>
</body>
</html>